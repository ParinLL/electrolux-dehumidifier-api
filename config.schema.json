{
  "pluginAlias": "ElectroluxDehumidifier",
  "pluginType": "platform",
  "singular": true,
  "strictValidation": false,
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "required": true,
        "default": "Electrolux Dehumidifier"
      },
      "apiKey": {
        "title": "API Key",
        "type": "string",
        "required": true,
        "description": "Your Electrolux API key (x-api-key)"
      },
      "refreshToken": {
        "title": "Refresh Token",
        "type": "string",
        "required": true,
        "description": "Your Electrolux refresh token"
      },
      "applianceId": {
        "title": "Appliance ID",
        "type": "string",
        "required": true,
        "description": "Your Electrolux dehumidifier appliance ID"
      },
      "debug": {
        "title": "Debug Logging",
        "type": "boolean",
        "default": false,
        "description": "Enable debug logging"
      }
    }
  }
}
